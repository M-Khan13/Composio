# Template only. Copy to .env and fill in there.
# NEVER put real keys in this file — it is committed to git.

# Composio SDK — https://app.composio.dev  (Settings -> API Keys)
COMPOSIO_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite
CONCURRENCY=1
GEMINI_MIN_INTERVAL_MS=6500
